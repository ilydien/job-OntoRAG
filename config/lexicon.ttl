lex:entry_holland_enterprising a lex:LexicalEntry ;
    rdfs:label "Enterprising vocabulary"@en ;
    lex:keyword "memimpin", "pemimpin", "bisnis", "wirausaha", "menjual", "negosiasi", "mempengaruhi", "manajemen", "mengelola", "lead", "leader", "business", "entrepreneur", "sell", "negotiate", "persuade", "manage" ;
    lex:targetKind "holland" ;
