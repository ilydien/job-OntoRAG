lex:entry_holland_conventional a lex:LexicalEntry ;
    rdfs:label "Conventional vocabulary"@en ;
    lex:keyword "teratur", "administrasi", "arsip", "detail", "keuangan", "prosedur", "sistematis", "akuntansi", "organized", "administration", "records", "detail", "finance", "procedure", "systematic", "accounting" ;
    lex:targetKind "holland" ;
