@prefix : <https://www.onetcenter.org/rdf/schema/onet/> .
@prefix career: <https://example.org/career#> .
@prefix lex: <https://example.org/lex#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# =============================================================================
# Declarative extraction lexicon
# =============================================================================
# Every keyword/pattern is domain knowledge and lives here, not in Python.
# targetKind values understood by the generic extractor:
#   holland, holland_code, element, education, job_zone, negation

# -----------------------------------------------------------------------------
# Education patterns
# -----------------------------------------------------------------------------

lex:entry_education_s1 a lex:LexicalEntry ;
    rdfs:label "S1 / bachelor expressions"@en ;
    lex:pattern "\\b(?:s1|sarjana|strata\\s*1|strata\\s*satu|bachelor|undergraduate)\\b" ;
    lex:targetKind "education" ;
    lex:target "S1" ;
    lex:weight "1.0"^^xsd:decimal .

lex:entry_education_d3 a lex:LexicalEntry ;
    rdfs:label "D3 / associate expressions"@en ;
    lex:pattern "\\b(?:d3|diploma\\s*3|diploma\\s*tiga|associate(?:'s)?\\s*degree|associate)\\b" ;
    lex:targetKind "education" ;
    lex:target "D3" ;
    lex:weight "1.0"^^xsd:decimal .

lex:entry_education_s2 a lex:LexicalEntry ;
    rdfs:label "S2 / master expressions"@en ;
    lex:pattern "\\b(?:s2|magister|strata\\s*2|master(?:'s)?\\s*degree|master)\\b" ;
    lex:targetKind "education" ;
    lex:target "S2" ;
    lex:weight "1.0"^^xsd:decimal .

lex:entry_education_s3 a lex:LexicalEntry ;
    rdfs:label "S3 / doctoral expressions"@en ;
    lex:pattern "\\b(?:s3|doktor|doctorate|doctoral|phd|strata\\s*3)\\b" ;
    lex:targetKind "education" ;
    lex:target "S3" ;
    lex:weight "1.0"^^xsd:decimal .

lex:entry_education_sma a lex:LexicalEntry ;
    rdfs:label "high-school expressions"@en ;
    lex:pattern "\\b(?:sma|smk|sekolah\\s*menengah|high\\s*school|senior\\s*high)\\b" ;
    lex:targetKind "education" ;
    lex:target "Level2_HighSchool" ;
    lex:weight "1.0"^^xsd:decimal .

lex:entry_education_no_degree a lex:LexicalEntry ;
    rdfs:label "no-degree expressions"@en ;
    lex:pattern "\\b(?:belum|tidak)\\s+(?:memiliki|punya|memperoleh|mengantongi)\\s+(?:gelar|ijazah)(?:\\s+apapun)?\\b" ;
    lex:pattern "\\b(?:belum|tidak)\\s+bergelar\\b" ;
    lex:pattern "\\bbelum\\s+(?:lulus\\s+)?(?:sarjana|kuliah|s1)\\b" ;
    lex:targetKind "education" ;
    lex:target "Level2_HighSchool" ;
    lex:weight "1.0"^^xsd:decimal .

lex:entry_education_in_progress a lex:LexicalEntry ;
    rdfs:label "in-progress tertiary education expressions"@en ;
    rdfs:comment "A current tertiary student is treated as a prospective bachelor-level candidate for career recommendations, not as a graduate."@en ;
    lex:pattern "\\b(?:masih|sedang)\\s+(?:dalam\\s+masa\\s+)?(?:kuliah|belajar|menempuh|studi)\\b" ;
    lex:pattern "\\b(?:mahasiswa|mahasiswi)\\b" ;
    lex:pattern "\\b(?:semester|tingkat)\\s+[1-9][0-9]*\\b" ;
    lex:targetKind "education" ;
    lex:target "S1" ;
    lex:weight "1.0"^^xsd:decimal .

# -----------------------------------------------------------------------------
# Job-zone and RIASEC-code patterns
# -----------------------------------------------------------------------------

lex:entry_job_zone a lex:LexicalEntry ;
    rdfs:label "explicit job-zone expression"@en ;
    lex:pattern "(?:job\\s*zone|zona(?:\\s*kerja)?|level\\s*kerja)\\s*([1-5])" ;
    lex:targetKind "job_zone" ;
    lex:weight "1.0"^^xsd:decimal .

lex:entry_riasec_code a lex:LexicalEntry ;
    rdfs:label "explicit RIASEC code"@en ;
    lex:pattern "\\b([RIASEC]{2,3})\\b" ;
    lex:targetKind "holland_code" ;
    lex:weight "1.0"^^xsd:decimal .

# -----------------------------------------------------------------------------
# Negation markers
# -----------------------------------------------------------------------------

lex:negationWindow a owl:DatatypeProperty ;
    rdfs:label "maximum characters between a negation marker and its target"@en .

lex:entry_negation a lex:LexicalEntry ;
    rdfs:label "negation markers"@en ;
    lex:keyword "tidak", "bukan", "tanpa", "jangan", "kurang", "not", "no", "without" ;
    lex:targetKind "negation" ;
    lex:negationWindow 35 ;
    lex:weight "1.0"^^xsd:decimal .

# -----------------------------------------------------------------------------
# Holland / RIASEC vocabulary
# -----------------------------------------------------------------------------

lex:entry_holland_realistic a lex:LexicalEntry ;
    rdfs:label "Realistic vocabulary"@en ;
    lex:keyword "mesin", "alat", "peralatan", "konstruksi", "bangunan", "arsitektur", "gedung", "hewan", "veteriner", "ternak", "fisik", "lapangan", "praktik", "praktis", "teknisi", "memperbaiki", "outdoor", "machine", "tools", "construction", "physical", "hands-on", "repair" ;
    lex:targetKind "holland" ;
    lex:target "Realistic" ;
    lex:weight "0.75"^^xsd:decimal .

lex:entry_phrase_build_model a lex:LexicalEntry ;
    rdfs:label "building a model/system (abstract construction)"@en ;
    lex:pattern "\\bmembangun\\s+(?:model|sistem|aplikasi|algoritma|perangkat\\s+lunak|solusi\\s+data|dashboard)\\b" ;
    lex:targetKind "holland" ;
    lex:target "Investigative" ;
    lex:weight "0.75"^^xsd:decimal .

lex:entry_phrase_build_structure a lex:LexicalEntry ;
    rdfs:label "building a physical structure"@en ;
    lex:pattern "\\bmembangun\\s+(?:rumah|gedung|jembatan|jalan|infrastruktur|proyek\\s+konstruksi|bangunan)\\b" ;
    lex:targetKind "holland" ;
    lex:target "Realistic" ;
    lex:weight "0.75"^^xsd:decimal .

