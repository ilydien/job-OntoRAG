    rdfs:label "Investigative vocabulary"@en ;
    lex:keyword "riset", "penelitian", "meneliti", "analisis", "menganalisis", "data", "ilmiah", "sains", "sains data", "ilmu data", "data science", "logika", "eksperimen", "memecahkan", "model", "pemodelan", "statistik", "algoritma", "machine learning", "pembelajaran mesin", "pemrograman", "research", "analysis", "analyze", "science", "scientific", "experiment", "problem solving" ;
    lex:targetKind "holland" ;
    lex:target "Investigative" ;
    lex:weight "0.75"^^xsd:decimal .

