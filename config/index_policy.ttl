@prefix : <https://www.onetcenter.org/rdf/schema/onet/> .
@prefix career: <https://example.org/career#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

career:DefaultIndexPolicy a career:IndexPolicy ;
    rdfs:label "Default O*NET retrieval index policy"@en ;
    career:indexedRatingType "AbilitiesRating" ;
    career:indexedRatingType "WorkActivitiesRating" ;
    career:indexedRatingType "KnowledgeRating" ;
    career:indexedRatingType "EssentialSkillsRating" ;
    career:indexedRatingType "TransferableSkillsRating" ;
    career:indexedRatingType "SpecificInterestAreasRating" ;
    career:indexedRatingType "CareerInterestTypesRating" ;
    career:profileRatingType "TrainingAndExperienceRating" ;
    career:profileRatingType "EducationRating" ;
    career:profileRatingType "WorkContextRating" ;
    career:profileRatingType "WorkStylesRating" ;
    career:coreTaskType "Core" ;
    career:taskRelevanceScaleId "RT" ;
    career:taskFrequencyScaleId "FT" ;
    career:requireCompleteData true ;
    career:minElementRatings 0 ;
    career:minFtsTokenLength 2 ;
    career:ftsTokenize "unicode61 remove_diacritics 2" ;
    career:embeddingModel "intfloat/multilingual-e5-small" ;
    career:embeddingBatchSize 32 ;
    career:embeddingMaxTasks 8 ;
    career:embeddingMaxElements 12 ;
    career:embeddingMaxJobTitles 5 ;
    career:embeddingCardVersion "1" ;
    career:indexVersion "4" .
